# Postgres connection for the API, worker and migrations
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
# Separate database for the test suite. Its name must contain "test", because the fixture drops its schema.
TEST_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_test
# How long a worker holds a job before it can be reclaimed
LEASE_SECONDS=30
# Attempts before a job is marked failed
MAX_ATTEMPTS=5
# How long an idle worker sleeps between polls
WORKER_POLL_SECONDS=0.5
